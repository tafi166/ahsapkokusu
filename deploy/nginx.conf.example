# Example nginx site for one machine running both the storefront and the API.
# The storefront is the static build in dist/; the API listens on 127.0.0.1:3000
# (TRUST_PROXY=loopback). Adjust server_name, certificate paths and the root.

server {
    listen 80;
    server_name shop.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name shop.example.com;

    ssl_certificate     /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;

    root /srv/parametrika/dist;

    # Quote uploads are up to 5 MB plus form fields; the admin saves the product list as JSON.
    client_max_body_size 6m;

    # Storefront security headers. nginx drops inherited add_header lines in any
    # location that sets its own, so they live in a snippet included everywhere.
    include /etc/nginx/snippets/parametrika-security-headers.conf;

    # API (sets its own security headers via helmet).
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Generated from the catalog by the API.
    location = /sitemap.xml { proxy_pass http://127.0.0.1:3000/api/sitemap.xml; }
    location = /robots.txt  { proxy_pass http://127.0.0.1:3000/api/robots.txt; }

    # Hashed build assets never change under a given name.
    location /assets/ {
        include /etc/nginx/snippets/parametrika-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: every other path renders index.html.
    location / {
        include /etc/nginx/snippets/parametrika-security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
