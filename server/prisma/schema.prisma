generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Values mirror the storefront's string unions (src/types/index.ts); see
// src/catalog/mapping.ts for the conversion.
enum Currency {
  TRY
  USD
}

enum Availability {
  IN_STOCK
  MADE_TO_ORDER
  SOLD_OUT
  DIGITAL
}

enum DeliveryType {
  DIGITAL
  PHYSICAL
  BOTH
}

enum ProductType {
  WALL_ART
  MULTILAYER_ART
  FURNITURE
  WALL_CLOCK
  DECOR
}

model Category {
  slug      String   @id
  title     String
  sortOrder Int
  /// Presentational content (descriptions, subcategories, facets, SEO, FAQ).
  content   Json
  /// True for the hand-written demo catalog.
  isSample  Boolean  @default(false)
  /// Passive: left out of the storefront (menus, pages, its products); still edited in the admin panel.
  isHidden  Boolean  @default(false)
  products  Product[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Product {
  id             String       @id
  slug           String       @unique
  title          String
  categorySlug   String
  category       Category     @relation(fields: [categorySlug], references: [slug], onUpdate: Cascade, onDelete: Restrict)
  subcategory    String?
  price          Decimal      @db.Decimal(12, 2)
  compareAtPrice Decimal?     @db.Decimal(12, 2)
  currency       Currency
  availability   Availability
  deliveryType   DeliveryType
  productType    ProductType
  stock          Int?
  featured       Boolean      @default(false)
  bestSeller     Boolean      @default(false)
  newProduct     Boolean      @default(false)
  rating         Decimal?     @db.Decimal(2, 1)
  reviewCount    Int?
  sortOrder      Int
  /// Presentational fields (images, variants, dimensions, SEO, ...) — filtered/sorted fields are columns.
  details        Json
  /// True for the hand-written demo catalog.
  isSample       Boolean      @default(false)
  /// A draft kept in the admin panel: never served by public endpoints, the sitemap or orders.
  isHidden       Boolean      @default(false)
  /// Catalog dates shown in the storefront (date-only in the source data).
  publishedAt    DateTime     @db.Timestamptz(3)
  contentUpdatedAt DateTime   @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([categorySlug, sortOrder])
}

// ---------------------------------------------------------------------------
// Admin users and sessions
// ---------------------------------------------------------------------------

enum Role {
  /// Everything an editor can do, plus managing users.
  ADMIN
  /// Edits catalog and content, reads quote requests.
  EDITOR
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased; unique case-insensitively.
  email             String    @unique
  name              String
  passwordHash      String
  role              Role
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime  @default(now()) @db.Timestamptz(3)
  sessions          Session[]
  laserMachines LaserMachineProfile[]
  laserMaterials LaserMaterial[]
  laserPresets LaserCutPreset[]
  laserDesigns LaserDesignFile[]
  laserQuotes LaserQuote[]
  laserRuns LaserProductionRun[]
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the cookie token — the token itself is never stored.
  tokenHash  String   @unique
  /// Sent back by the client in X-CSRF-Token on state-changing requests. Useless without the cookie.
  csrfToken  String
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  /// Idle timeout counts from here.
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  /// Absolute timeout.
  expiresAt  DateTime @db.Timestamptz(3)

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(3)
  /// Null for anonymous events (e.g. a failed login).
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  details     Json     @default("{}")

  @@index([at])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Editable site content and uploaded media
// ---------------------------------------------------------------------------

/// One row per editable block (brand, homeContent, testimonials, ...). A missing
/// row means the storefront's built-in default applies.
model SiteContent {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// Uploaded images. Files live under UPLOAD_DIR/media named by id; served by /api/media/:file.
model Media {
  id          String   @id @default(uuid()) @db.Uuid
  contentType String
  extension   String
  sizeBytes   Int
  sha256      String
  uploadedById String? @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// CNC quote requests
// ---------------------------------------------------------------------------

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  CLOSED
}

/// A customer's request to have their own SVG cut. The file is stored privately
/// under UPLOAD_DIR/quotes/<fileId>.svg and only staff can download it.
model QuoteRequest {
  id           String      @id @default(uuid()) @db.Uuid
  /// Shown to the customer; random, not guessable from other requests.
  reference    String      @unique
  status       QuoteStatus @default(NEW)
  widthCm      Decimal     @db.Decimal(7, 1)
  heightCm     Decimal     @db.Decimal(7, 1)
  material     String
  quantity     Int
  contactName  String
  contactEmail String
  contactPhone String?
  notes        String?
  /// Original name, for display only — never used as a path.
  fileName     String
  fileId       String      @unique @db.Uuid
  fileSize     Int
  fileSha256   String
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Orders (prototype: test orders only — no payment is taken)
// ---------------------------------------------------------------------------

enum OrderStatus {
  RECEIVED
  PROCESSING
  SHIPPED
  CANCELLED
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  /// "T-XXXXXXXX" while orders are tests.
  number            String      @unique
  /// Every order is a test until a payment provider is integrated.
  isTest            Boolean     @default(true)
  status            OrderStatus @default(RECEIVED)
  currency          Currency
  /// Sum of the lines, priced by the server. Shipping is confirmed separately.
  subtotal          Decimal     @db.Decimal(12, 2)
  customerName      String
  customerEmail     String
  customerPhone     String
  /// Shipping address — null when every line is a digital download.
  addressLine       String?
  district          String?
  city              String?
  postalCode        String?
  notes             String?
  lines             OrderLine[]
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

/// Snapshot of what was ordered, at the price the server computed then.
model OrderLine {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sortOrder   Int
  productId   String
  productSlug String
  title       String
  /// Chosen options, normalized to the axes the product offers.
  options     Json    @default("{}")
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Messages from the contact and custom-design forms
// ---------------------------------------------------------------------------

enum MessageKind {
  /** Contact page, or the "ask about this product" button. */
  CONTACT
  /** Custom design page, free-text idea. */
  DESIGN
}

enum MessageStatus {
  NEW
  ANSWERED
  CLOSED
}

model ContactMessage {
  id           String        @id @default(uuid()) @db.Uuid
  kind         MessageKind
  status       MessageStatus @default(NEW)
  name         String
  email        String
  phone        String?
  message      String
  /// Product the visitor asked about, if any (kept as text: the product may be deleted later).
  productId    String?
  productTitle String?
  /// Category chosen on the custom-design form.
  categorySlug String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

// Private research records; deliberately unrelated to the public Product catalog.
model ResearchItem {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  sourceUrl   String?
  notes       String @default("")
  archived    Boolean @default(false)
  version     Int @default(1)
  createdById String @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  collections ResearchCollectionItem[]
  @@index([archived, updatedAt])
}

model ResearchCollection {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  description String @default("")
  version     Int @default(1)
  createdById String @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  items       ResearchCollectionItem[]
}

model ResearchCollectionItem {
  collectionId String @db.Uuid
  itemId       String @db.Uuid
  collection   ResearchCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item         ResearchItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@id([collectionId, itemId])
  @@index([itemId])
}

model ResearchCostEstimate {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  input       Json
  result      Json
  version     Int @default(1)
  createdById String @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@index([updatedAt])
}

model ResearchImageBatch {
  id              String @id @default(uuid()) @db.Uuid
  title           String
  sourceUrl       String
  permissionBasis String
  permissionNote  String
  permissionUntil DateTime? @db.Timestamptz(3)
  revoked         Boolean @default(false)
  createdById     String @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)
  images          ResearchImage[]
  @@index([expiresAt])
}
model ResearchImage {
  id          String @id @default(uuid()) @db.Uuid
  batchId     String @db.Uuid
  batch       ResearchImageBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productName String
  fileName    String
  contentType String
  extension   String
  sizeBytes   Int
  sha256      String
  width       Int
  height      Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@unique([batchId, sha256])
}
model ResearchImageExport {
  id           String @id @default(uuid()) @db.Uuid
  imageIds     Json
  status       String @default("QUEUED")
  error        String?
  sizeBytes    Int?
  createdById  String @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  @@index([status, createdAt])
  @@index([expiresAt])
}

/// ADMIN-reviewed publication permission. Snapshots survive private-gallery expiry.
model ResearchProductImageGrant {
  id             String @id @default(uuid()) @db.Uuid
  productId      String
  mediaId        String @db.Uuid
  sourceImageId  String @db.Uuid
  sourceUrl      String
  sha256         String
  evidence       String
  reviewedById   String @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@index([productId])
  @@index([mediaId])
}

// Private production studio: no relation to public media or catalog snapshots.
model LaserMachineProfile {
  id String @id @default(uuid()) @db.Uuid
  version Int @default(1)
  data Json
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  presets LaserCutPreset[]
  quotes LaserQuote[]
}
model LaserMaterial {
  id String @id @default(uuid()) @db.Uuid
  version Int @default(1)
  data Json
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  presets LaserCutPreset[]
  quotes LaserQuote[]
}
model LaserCutPreset {
  id String @id @default(uuid()) @db.Uuid
  version Int @default(1)
  machineId String @db.Uuid
  materialId String @db.Uuid
  machine LaserMachineProfile @relation(fields: [machineId], references: [id], onDelete: Restrict)
  material LaserMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  data Json
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([machineId, materialId])
}
model LaserDesignFile {
  id String @id @default(uuid()) @db.Uuid
  name String
  sha256 String
  /// Private source text. Not served from /api/media or /api/site.
  content String @db.Text
  analysis Json
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  quotes LaserQuote[]
}
model LaserQuote {
  id String @id @default(uuid()) @db.Uuid
  name String
  status String @default("DRAFT")
  /// Revision/duplicate ancestry; every calculation snapshot remains immutable.
  parentId String? @db.Uuid
  parent LaserQuote? @relation("LaserQuoteRevision", fields: [parentId], references: [id], onDelete: Restrict)
  revisions LaserQuote[] @relation("LaserQuoteRevision")
  designId String @db.Uuid
  design LaserDesignFile @relation(fields: [designId], references: [id], onDelete: Restrict)
  machineId String @db.Uuid
  machine LaserMachineProfile @relation(fields: [machineId], references: [id], onDelete: Restrict)
  materialId String @db.Uuid
  material LaserMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  snapshot Json
  engineVersion String
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  runs LaserProductionRun[]
  @@index([createdAt, id])
}
model LaserProductionRun {
  id String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  quote LaserQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  actualS Float
  previewS Float?
  estimatedS Float
  quantity Int
  notes String
  quality String
  producedAt DateTime @db.Timestamptz(3)
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([quoteId, producedAt])
}
