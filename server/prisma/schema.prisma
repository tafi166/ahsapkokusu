generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Values mirror the storefront's string unions (src/types/index.ts); see
// src/catalog/mapping.ts for the conversion.
enum Currency {
  TRY
  USD
}

enum Availability {
  IN_STOCK
  MADE_TO_ORDER
  SOLD_OUT
  DIGITAL
}

enum DeliveryType {
  DIGITAL
  PHYSICAL
  BOTH
}

enum ProductType {
  WALL_ART
  MULTILAYER_ART
  FURNITURE
  WALL_CLOCK
  DECOR
}

model Category {
  slug      String   @id
  title     String
  sortOrder Int
  /// Presentational content (descriptions, subcategories, facets, SEO, FAQ).
  content   Json
  /// True for the hand-written demo catalog.
  isSample  Boolean  @default(false)
  products  Product[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Product {
  id             String       @id
  slug           String       @unique
  title          String
  categorySlug   String
  category       Category     @relation(fields: [categorySlug], references: [slug], onUpdate: Cascade, onDelete: Restrict)
  subcategory    String?
  price          Decimal      @db.Decimal(12, 2)
  compareAtPrice Decimal?     @db.Decimal(12, 2)
  currency       Currency
  availability   Availability
  deliveryType   DeliveryType
  productType    ProductType
  stock          Int?
  featured       Boolean      @default(false)
  bestSeller     Boolean      @default(false)
  newProduct     Boolean      @default(false)
  rating         Decimal?     @db.Decimal(2, 1)
  reviewCount    Int?
  sortOrder      Int
  /// Presentational fields (images, variants, dimensions, SEO, ...) — filtered/sorted fields are columns.
  details        Json
  /// True for the hand-written demo catalog.
  isSample       Boolean      @default(false)
  /// Catalog dates shown in the storefront (date-only in the source data).
  publishedAt    DateTime     @db.Timestamptz(3)
  contentUpdatedAt DateTime   @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([categorySlug, sortOrder])
}

// ---------------------------------------------------------------------------
// Admin users and sessions
// ---------------------------------------------------------------------------

enum Role {
  /// Everything an editor can do, plus managing users.
  ADMIN
  /// Edits catalog and content, reads quote requests.
  EDITOR
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased; unique case-insensitively.
  email             String    @unique
  name              String
  passwordHash      String
  role              Role
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime  @default(now()) @db.Timestamptz(3)
  sessions          Session[]
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the cookie token — the token itself is never stored.
  tokenHash  String   @unique
  /// Sent back by the client in X-CSRF-Token on state-changing requests. Useless without the cookie.
  csrfToken  String
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  /// Idle timeout counts from here.
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  /// Absolute timeout.
  expiresAt  DateTime @db.Timestamptz(3)

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(3)
  /// Null for anonymous events (e.g. a failed login).
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  details     Json     @default("{}")

  @@index([at])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Editable site content and uploaded media
// ---------------------------------------------------------------------------

/// One row per editable block (brand, homeContent, testimonials, ...). A missing
/// row means the storefront's built-in default applies.
model SiteContent {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// Uploaded images. Files live under UPLOAD_DIR/media named by id; served by /api/media/:file.
model Media {
  id          String   @id @default(uuid()) @db.Uuid
  contentType String
  extension   String
  sizeBytes   Int
  sha256      String
  uploadedById String? @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// CNC quote requests
// ---------------------------------------------------------------------------

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  CLOSED
}

/// A customer's request to have their own SVG cut. The file is stored privately
/// under UPLOAD_DIR/quotes/<fileId>.svg and only staff can download it.
model QuoteRequest {
  id           String      @id @default(uuid()) @db.Uuid
  /// Shown to the customer; random, not guessable from other requests.
  reference    String      @unique
  status       QuoteStatus @default(NEW)
  widthCm      Decimal     @db.Decimal(7, 1)
  heightCm     Decimal     @db.Decimal(7, 1)
  material     String
  quantity     Int
  contactName  String
  contactEmail String
  contactPhone String?
  notes        String?
  /// Original name, for display only — never used as a path.
  fileName     String
  fileId       String      @unique @db.Uuid
  fileSize     Int
  fileSha256   String
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}
