# Copy to server/.env (never committed) and adjust.

NODE_ENV=development
PORT=3000
# Public storefront origin, for sitemap.xml/robots.txt URLs (https in production).
SITE_URL=http://localhost:5173

# Local PostgreSQL started by `npm run db:local` (embedded-postgres, port 5433 so it
# doesn't collide with other local databases). The password below is a local-only
# development value; use a real secret anywhere else.
LOCAL_PG_PORT=5433
LOCAL_PG_USER=parametrika
LOCAL_PG_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://parametrika:change-me-local-only@localhost:5433/parametrika
# Integration tests wipe this database; it must end in _test.
TEST_DATABASE_URL=postgresql://parametrika:change-me-local-only@localhost:5433/parametrika_test

# --- Admin sessions -------------------------------------------------------------
# Origins allowed to send state-changing requests (comma-separated). In production,
# the storefront's public origin, e.g. https://www.example.com
ALLOWED_ORIGINS=http://localhost:5173
# true in production (HTTPS): Secure + __Host- cookie. The server refuses to start
# in production without it.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Login / password-change attempts per IP per minute.
AUTH_RATE_LIMIT_PER_MIN=10
# Anonymous quote requests and orders per IP per minute.
PUBLIC_FORM_RATE_LIMIT_PER_MIN=5
# Quote requests accepted from everyone in any 24 hours (each may store a file).
QUOTE_DAILY_LIMIT=200
# Contact and custom-design messages accepted from everyone in any 24 hours.
MESSAGE_DAILY_LIMIT=500
# Cart and (test) checkout. false = catalog mode: products, prices and "ask about
# this product" instead. Keep false on a public site until a payment provider exists.
ORDERS_ENABLED=false
# Proxies allowed to set X-Forwarded-For: "loopback" if the web server is on this
# machine, otherwise its address or subnet (e.g. 10.0.0.0/8).
TRUST_PROXY=loopback

# --- Uploads --------------------------------------------------------------------
# Uploaded images and CNC quote drawings. Keep it outside any web root; must be an
# absolute path in production.
UPLOAD_DIR=storage
MEDIA_MAX_BYTES=5242880

# --- Storefront -----------------------------------------------------------------
# Only where no web server serves the build (cPanel "Node.js App"): absolute path
# of the storefront's dist/ folder. This process then serves pages, assets,
# /sitemap.xml and /robots.txt itself. Leave unset behind nginx.
# STATIC_DIR=/home/user/app/dist

# Private ADMIN-only research library; external integrations remain disabled.
RESEARCH_ENABLED=true
