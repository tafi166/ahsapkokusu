# Copy to server/.env (never committed) and adjust.

NODE_ENV=development
PORT=3000

# Local PostgreSQL started by `npm run db:local` (embedded-postgres, port 5433 so it
# doesn't collide with other local databases). The password below is a local-only
# development value; use a real secret anywhere else.
LOCAL_PG_PORT=5433
LOCAL_PG_USER=parametrika
LOCAL_PG_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://parametrika:change-me-local-only@localhost:5433/parametrika
# Integration tests wipe this database; it must end in _test.
TEST_DATABASE_URL=postgresql://parametrika:change-me-local-only@localhost:5433/parametrika_test
